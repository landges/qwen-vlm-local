# Self-hosted GitLab API, for example: https://gitlab.internal/api/v4
GITLAB_API_URL=
GITLAB_PERSONAL_ACCESS_TOKEN=
# Separate secret required by clients when connecting to the local MCP endpoint.
GITLAB_MCP_AUTH_TOKEN=

# Jira Server/Data Center base URL and Personal Access Token.
JIRA_URL=
JIRA_PERSONAL_TOKEN=
